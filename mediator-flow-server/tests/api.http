### ──────────────────────────────────────────────────────────────
### 3. SEED: Compensation trace (failure + mixed compensations)
###    - DeductInventoryHandler fails
###    - RefundPaymentHandler compensation SUCCEEDS
###    - RestoreInventoryHandler compensation FAILS
### ──────────────────────────────────────────────────────────────
POST {{host}}/collect/steps
Content-Type: application/json

{
  "serviceName": "payment-service",
  "steps": [
    {
      "stepId": "cc000001-0000-4000-c000-000000000001",
      "instanceId": "payment-svc-01",
      "type": "COMMAND_DISPATCHED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": null,
      "name": "ProcessPaymentCommand",
      "payload": { "orderId": "ORD-COMP-002", "amount": 249.99, "currency": "USD", "customerId": "cust_38a7b" },
      "metadata": { "userId": "user-42", "source": "checkout-api" }
    },
    {
      "stepId": "cc000001-0000-4000-c000-000000000002",
      "instanceId": "payment-svc-01",
      "type": "BEHAVIOR_ENTERED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-000000000001",
      "name": "ExceptionHandlingBehavior",
