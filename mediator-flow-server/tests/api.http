### 6. GET All Traces — Paginated list
### ──────────────────────────────────────────────────────────────
GET {{host}}/api/traces?page=1&limit=50

> {%
  client.test("Traces list returned", function() {
    client.assert(response.status === 200, "Expected 200");
    client.assert(response.body.traces.length >= 2, "Should have at least 2 traces");
  });
%}

### ──────────────────────────────────────────────────────────────
### 7. GET Traces — Filter: only errors
### ──────────────────────────────────────────────────────────────
GET {{host}}/api/traces?hasErrors=true

> {%
  client.test("Error traces returned", function() {
    client.assert(response.status === 200, "Expected 200");
    client.assert(response.body.traces.length >= 1, "Should have compensation trace");
  });
%}

### ──────────────────────────────────────────────────────────────
### 8. GET Traces — Filter: only compensations
### ──────────────────────────────────────────────────────────────
