    },
    {
      "stepId": "cc000001-0000-4000-c000-00000000000d",
      "instanceId": "payment-svc-01",
      "type": "COMPENSATION_STARTED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-00000000000a",
      "eventId": "evt-comp-0002",
      "name": "RestoreInventoryHandler"
    },
    {
      "stepId": "cc000001-0000-4000-c000-00000000000e",
      "instanceId": "payment-svc-01",
      "type": "COMPENSATION_FAILED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-00000000000d",
      "eventId": "evt-comp-0002",
      "name": "RestoreInventoryHandler",
      "durationMs": 185,
      "error": "Database connection timeout - MANUAL INTERVENTION REQUIRED"
    },
    {
      "stepId": "cc000001-0000-4000-c000-00000000000f",
      "instanceId": "payment-svc-01",
      "type": "COMPENSATING_EVENT_PUBLISHED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-00000000000c",
      "eventId": "evt-comp-0003",
      "name": "PaymentRefundedEvent",
      "payload": { "orderId": "ORD-COMP-002", "refundId": "ref_zz9901", "amount": 249.99, "originalTransactionId": "txn_abc123" },
      "metadata": { "aggregateType": "Order", "aggregateId": "ORD-COMP-002" }
    }
  ]
}

