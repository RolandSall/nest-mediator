### ──────────────────────────────────────────────────────────────
### 9. GET Happy Trace — Full step details (no errors)
### ──────────────────────────────────────────────────────────────
GET {{host}}/api/traces/happy-trace-0001-0000-000000000000

> {%
  client.test("Happy trace loaded", function() {
    client.assert(response.status === 200, "Expected 200");
    client.assert(response.body.steps.length === 10, "Should have 10 steps");
    var errors = response.body.steps.filter(s => s.error);
    client.assert(errors.length === 0, "No errors in happy path");
  });
%}

### ──────────────────────────────────────────────────────────────
### 10. GET Compensation Trace — Full step details (with failures)
### ──────────────────────────────────────────────────────────────
GET {{host}}/api/traces/comp-trace-0001-0000-000000000000

> {%
  client.test("Compensation trace loaded", function() {
    client.assert(response.status === 200, "Expected 200");
    client.assert(response.body.steps.length === 15, "Should have 15 steps");
    var errors = response.body.steps.filter(s => s.error);
    client.assert(errors.length === 2, "Should have 2 errors (consumer fail + compensation fail)");
    var compensations = response.body.steps.filter(s => s.type.startsWith("COMPENSATION_"));
    client.assert(compensations.length === 4, "Should have 4 compensation steps");
  });
%}

