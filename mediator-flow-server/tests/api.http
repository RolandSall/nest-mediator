### QUERY ENDPOINTS — Run after seeding above
### ============================================================


### ──────────────────────────────────────────────────────────────
### 4. GET Topology — View the registered service graph
### ──────────────────────────────────────────────────────────────
GET {{host}}/api/topology

> {%
  client.test("Topology returned", function() {
    client.assert(response.status === 200, "Expected 200");
    var body = response.body;
    client.assert(body.commands.length > 0, "Should have commands");
    client.assert(body.events.length > 0, "Should have events");
    client.assert(body.behaviors.length > 0, "Should have behaviors");
  });
%}

