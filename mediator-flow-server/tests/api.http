### ============================================================
### MediatorFlow API Test Suite
### Run requests top-to-bottom: seed first, then query
### ============================================================

@host = http://localhost:4800

### ──────────────────────────────────────────────────────────────
### 1. SEED TOPOLOGY — Register the service and its components
### ──────────────────────────────────────────────────────────────
POST {{host}}/collect/topology
Content-Type: application/json

{
  "serviceName": "payment-service",
  "instanceId": "payment-svc-01",
  "bootedAt": "{{$isoTimestamp}}",
  "libraryVersion": "1.0.0",
  "commands": [
    { "commandName": "ProcessPaymentCommand", "handlerName": "ProcessPaymentHandler" },
    { "commandName": "CancelOrderCommand", "handlerName": "CancelOrderHandler" }
  ],
  "queries": [
    { "queryName": "GetOrderStatusQuery", "handlerName": "GetOrderStatusHandler" }
  ],
  "events": [
    {
      "eventName": "PaymentProcessedEvent",
      "aggregateType": "Order",
      "consumers": [
        { "consumerName": "EventStorePersistenceConsumer", "criticality": false, "order": 0, "hasCompensation": false },
        { "consumerName": "DeductInventoryHandler", "criticality": true, "order": 1, "hasCompensation": true },
        { "consumerName": "SendPaymentNotification", "criticality": false, "order": 2, "hasCompensation": false }
      ]
    },
    {
      "eventName": "InventoryDeductionFailedEvent",
      "aggregateType": "Order",
      "consumers": [
        { "consumerName": "RefundPaymentHandler", "criticality": true, "order": 1, "hasCompensation": false },
        { "consumerName": "RestoreInventoryHandler", "criticality": true, "order": 2, "hasCompensation": false }
      ]
    },
    {
      "eventName": "OrderCancelledEvent",
      "aggregateType": "Order",
      "consumers": [
        { "consumerName": "EventStorePersistenceConsumer", "criticality": false, "order": 0, "hasCompensation": false },
        { "consumerName": "ReleaseInventoryHandler", "criticality": true, "order": 1, "hasCompensation": true },
        { "consumerName": "NotifyCustomerHandler", "criticality": false, "order": 2, "hasCompensation": false }
      ]
    }
  ],
  "behaviors": [
    { "behaviorName": "ExceptionHandlingBehavior", "priority": 1, "scope": "global", "requestTypeName": null },
    { "behaviorName": "RetryBehavior",             "priority": 2, "scope": "global", "requestTypeName": null },
    { "behaviorName": "LoggingBehavior",            "priority": 3, "scope": "global", "requestTypeName": null },
    { "behaviorName": "PerformanceBehavior",        "priority": 4, "scope": "global", "requestTypeName": null },
    { "behaviorName": "ValidationBehavior",         "priority": 5, "scope": "command", "requestTypeName": "ProcessPaymentCommand" }
  ],
  "aggregates": [
    { "aggregateType": "Order", "repositoryName": "OrderRepository", "eventTypes": ["PaymentProcessedEvent", "InventoryDeductionFailedEvent", "OrderCancelledEvent"] }
  ]
}

> {%
  client.test("Topology seeded", function() {
    client.assert(response.status === 201, "Expected 201");
  });
%}

