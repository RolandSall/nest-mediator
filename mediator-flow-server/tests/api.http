    },
    {
      "stepId": "cc000001-0000-4000-c000-000000000004",
      "instanceId": "payment-svc-01",
      "type": "BEHAVIOR_ENTERED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-000000000003",
      "name": "LoggingBehavior",
      "durationMs": 340
    },
    {
      "stepId": "cc000001-0000-4000-c000-000000000005",
      "instanceId": "payment-svc-01",
      "type": "COMMAND_HANDLER_STARTED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-000000000004",
      "name": "ProcessPaymentHandler",
      "durationMs": 35
    },
    {
      "stepId": "cc000001-0000-4000-c000-000000000006",
      "instanceId": "payment-svc-01",
      "type": "EVENT_PUBLISHED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-000000000005",
      "eventId": "evt-comp-0001",
      "name": "PaymentProcessedEvent",
      "payload": { "orderId": "ORD-COMP-002", "transactionId": "txn_abc123", "amount": 249.99 },
      "metadata": { "aggregateType": "Order", "aggregateId": "ORD-COMP-002" }
    },
    {
      "stepId": "cc000001-0000-4000-c000-000000000007",
      "instanceId": "payment-svc-01",
      "type": "SYSTEM_CONSUMER_STARTED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-000000000006",
      "eventId": "evt-comp-0001",
      "name": "EventStorePersistenceConsumer"
    },
    {
      "stepId": "cc000001-0000-4000-c000-000000000008",
      "instanceId": "payment-svc-01",
      "type": "SYSTEM_CONSUMER_COMPLETED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
