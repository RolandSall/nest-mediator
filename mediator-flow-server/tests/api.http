    },
    {
      "stepId": "cc000001-0000-4000-c000-000000000003",
      "instanceId": "payment-svc-01",
      "type": "BEHAVIOR_ENTERED",
      "timestamp": "{{$isoTimestamp}}",
      "correlationId": "comp-trace-0001-0000-000000000000",
      "causationId": "cc000001-0000-4000-c000-000000000002",
