{
  "name": "mediator-flow-server",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "dev:api": "npx ts-node -T src/main.ts",
    "dev:ui": "cd ui && npm run dev",
    "dev:start": "./scripts/dev-start.sh",
    "dev:stop": "./scripts/dev-start.sh stop",
    "build": "nest build",
    "build:ui": "cd ui && npm ci && npm run build",
    "build:all": "npm run build:ui && npm run build",
    "start": "node dist/main.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "archiver": "^7.0.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0"
  }
}
