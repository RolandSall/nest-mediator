{
  "name": "@rolandsall24/nest-mediator",
  "version": "1.2.0-beta.1",
  "description": "A lightweight CQRS (Command Query Responsibility Segregation) mediator pattern implementation for NestJS applications with optional event sourcing",
  "author": "Roland Salloum",
  "license": "MIT",
  "homepage": "https://github.com/RolandSall/nest-mediator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RolandSall/nest-mediator.git"
  },
  "bugs": {
    "url": "https://github.com/RolandSall/nest-mediator/issues"
  },
  "keywords": [
    "nestjs",
    "cqrs",
    "mediator",
    "ddd",
    "domain-driven-design",
    "domain-events",
    "event-sourcing",
    "event-store",
    "aggregate",
    "saga",
    "compensation",
    "auditing",
    "audit-trail",
    "tracing",
    "command",
    "query",
    "handler",
    "pattern",
    "typescript",
    "pipeline",
    "behaviors",
    "validation"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "images",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "publish:npm": "npm publish --access public",
    "release:patch": "npm version patch && npm publish --access public",
    "release:minor": "npm version minor && npm publish --access public",
    "release:major": "npm version major && npm publish --access public",
    "test:integration": "node test/integration/event-store.integration.mjs",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "cd mediator-flow-server && ./scripts/docker-build.sh",
    "docker:push": "cd mediator-flow-server && ./scripts/docker-push.sh"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "pg": "8.16.3"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.11",
    "@nestjs/core": "11.1.11",
    "@types/node": "22.19.3",
    "@types/pg": "8.15.6",
    "@types/uuid": "10.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "testcontainers": "^11.11.0",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "example-source",
    "example-audit"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
